before_all do
  ensure_git_branch
  ensure_git_status_clean
  git_pull
end

platform :ios do
  private_lane :update_version do
    increment_version_number_in_plist(xcodeproj: '.ios/Scultpted.xcodeproj', bump_type: 'patch')
  end

  private_lane :staging_build do
    increment_build_number_in_plist(xcodeproj: '.ios/Scultpted.xcodeproj', target: 'Scultpted')
    gym(scheme: 'Scultpted', workspace: 'Scultpted.xcworkspace') 
  end

  lane :upload_to_testflight do
    staging_build
    upload_to_testflight
    commit_version_bump(message: 'bump build')
    push_to_git_remote
  end
end